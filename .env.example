# Скопируйте в .env:  cp .env.example .env
# Значения ниже подходят для локального запуска с docker compose.

# --- PostgreSQL ---
POSTGRES_DB=myanimelist
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_URL=jdbc:postgresql://localhost:5432/myanimelist

# --- JWT ---
# ОБЯЗАТЕЛЬНО Base64-строка: после декодирования ключ должен быть >= 32 байт (HS256).
# Сгенерировать: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# В проде обязательно замените на свой секрет.
JWT_SECRET=bG9jYWwtZGV2LW9ubHktc2VjcmV0LWtleS0zMmJ5dGUh
JWT_EXPIRATION=86400000

# --- Refresh token / cookie ---
REFRESH_TOKEN_DURATION=2592000000
REFRESH_TOKEN_MAX_AGE_SECONDS=2592000
COOKIE_PATH=/api/v1/auth
# true только за HTTPS
COOKIE_SECURE=false

# --- App (опционально) ---
SERVER_PORT=8080
